{
  "name": "van-dijk-rijschool-den-haag",
  "version": "1.0.0",
  "description": "Production-ready website voor Van Dijk Rijschool in regio Den Haag",
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "start": "HOSTNAME=127.0.0.1 PORT=${PORT:-3108} node .next/standalone/server.js",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/run-browser-qa.mjs",
    "test:smoke": "node scripts/smoke-standalone.mjs",
    "validate:production-env": "node scripts/validate-production-env.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run test:smoke && npm run test:browser",
    "lint": "eslint . --ignore-pattern .next"
  },
  "dependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.3",
    "playwright": "1.62.1"
  },
  "type": "module",
  "displayName": "Van Dijk - Rijschool | Rijschool Den Haag",
  "allowScripts": {
    "sharp": true,
    "unrs-resolver": true
  }
}
