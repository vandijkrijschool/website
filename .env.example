# Niet-geheime publieke en runtimeconfiguratie.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_INDEXING_ENABLED=false
APP_ENVIRONMENT=development
APP_REVISION=development

# Optioneel: gebruik geauthenticeerde SMTP in plaats van directe aflevering aan de MX-hosts.
LEAD_SMTP_HOSTS=mx1.mijndomein.nl,mx2.mijndomein.nl
LEAD_SMTP_PORT=25
