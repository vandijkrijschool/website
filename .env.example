# Prototype is noindex by default. Change only for the confirmed production site.
NEXT_PUBLIC_SITE_MODE=prototype
NEXT_PUBLIC_SITE_URL=https://vandijkrijschool.nl

# Future server-side NXTDRIVE integration. Never expose private credentials with NEXT_PUBLIC_.
NXTDRIVE_API_BASE_URL=
NXTDRIVE_TENANT_ID=
NXTDRIVE_API_KEY=
NXTDRIVE_WEBHOOK_SECRET=

# Future lead notifications.
LEAD_NOTIFICATION_FROM=
LEAD_NOTIFICATION_TO=
